
#!name=去留订阅到期时间测试
#!desc=RevenueCat 订阅到期时间模拟与客户端校验测试
# ==UserScript==
# @ScriptName        去留订阅到期时间测试
# @Suitable          Shadowrocket
# @Version           V1.2.0
# @UpdateTime        2026-11-08
# ==/UserScript==

[Script]
# GET /v1/subscribers/{user_id}
# POST /v1/receipts
# 仅用于自有测试域名

LingerExpiryRequest = type=http-request,pattern=^https:\/\/rc-mock\.example\.test\/v1\/(subscribers\/[^/?#]+|receipts)(\?.*)?$,script-path=https://raw.githubusercontent.com/johnnywwy/Linger_pro/main/LingerPro.js,timeout=10

LingerExpiryResponse = type=http-response,pattern=^https:\/\/rc-mock\.example\.test\/v1\/(subscribers\/[^/?#]+|receipts)(\?.*)?$,requires-body=true,script-path=https://raw.githubusercontent.com/johnnywwy/Linger_pro/main/LingerPro.js,timeout=10

[MITM]
hostname = %APPEND% rc-mock.example.test
